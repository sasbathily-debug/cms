DB_HOST=localhost
DB_PORT=5432
DB_NAME=projet
DB_USER=postgres
DB_PASSWORD=changeme

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# true si le fournisseur Redis exige TLS (ex. Upstash)
REDIS_SSL=false

# Générer avec : openssl rand -base64 32
JWT_SECRET=replace-me-with-a-random-32-byte-secret
OTP_TTL_MINUTES=10

# mail : "log" (par défaut, affiche l'OTP dans les logs, aucune clé requise), "smtp" ou "brevo"
# ATTENTION : "smtp" ne fonctionne qu'en local. Render (et la plupart des hébergeurs
# cloud) bloque les ports SMTP sortants (25/465/587) -> utiliser "brevo" en production.
MAIL_PROVIDER=log
MAIL_FROM=GoGaindé <noreply@example.com>
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# provider "brevo" (API HTTP, fonctionne sur Render) : https://app.brevo.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Dr Aissatou Fall

# URL du frontend, utilisée pour les liens (bouton "Voir mes rendez-vous") dans les emails
FRONTEND_URL=http://localhost:4200

# storage : "local" (par défaut, disque local, aucune clé requise) ou "cloudinary"
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
