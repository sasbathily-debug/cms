DB_HOST=localhost
DB_PORT=5432
DB_NAME=projet
DB_USER=postgres
DB_PASSWORD=changeme

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Générer avec : openssl rand -base64 32
JWT_SECRET=replace-me-with-a-random-32-byte-secret
OTP_TTL_MINUTES=10

# mail : "log" (par défaut, affiche l'OTP dans les logs, aucune clé requise) ou "smtp"
MAIL_PROVIDER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# storage : "local" (par défaut, disque local, aucune clé requise) ou "cloudinary"
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
